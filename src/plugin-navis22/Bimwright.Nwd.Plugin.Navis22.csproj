<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Bimwright.Nwd.Plugin</RootNamespace>
    <AssemblyName>Bimwright.Nwd.Plugin.Navis22</AssemblyName>
    <Version>1.0.1</Version>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <NavisworksYear>2022</NavisworksYear>
    <DefineConstants>$(DefineConstants);NAVIS2022</DefineConstants>
    <NavisworksInstallDir Condition="'$(NavisworksInstallDir)' == ''">C:\Program Files\Autodesk\Navisworks Manage 2022</NavisworksInstallDir>
  </PropertyGroup>

  <Target Name="ValidateNavisworksReferences" BeforeTargets="ResolveReferences" Condition="'$(SkipNavisworksReferenceCheck)' != 'true'">
    <Error Condition="!Exists('$(NavisworksInstallDir)\Autodesk.Navisworks.Api.dll')"
           Text="Navisworks API not found at $(NavisworksInstallDir). Pass /p:NavisworksInstallDir=&quot;C:\Program Files\Autodesk\Navisworks Manage 2022&quot; or /p:SkipNavisworksReferenceCheck=true for project-shape checks." />
  </Target>

  <ItemGroup>
    <Reference Include="Autodesk.Navisworks.Api">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Api.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Controls">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Controls.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Clash">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Clash.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Timeliner">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Timeliner.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Takeoff">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Takeoff.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.ComApi">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.ComApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Autodesk.Navisworks.Interop.ComApi">
      <HintPath>$(NavisworksInstallDir)\Autodesk.Navisworks.Interop.ComApi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="AdWindows">
      <HintPath>$(NavisworksInstallDir)\AdWindows.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="navisworks.gui.roamer">
      <HintPath>$(NavisworksInstallDir)\navisworks.gui.roamer.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.8.0" />
    <PackageReference Include="IsExternalInit" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\shared\**\*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\shared\Plugin\NwdRibbon.xaml">
      <LogicalName>NwdRibbon.xaml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
